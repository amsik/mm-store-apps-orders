// Prisma 6.19 is pinned: Prisma 7 dropped MongoDB and Prisma 8 is still a release candidate (see ADR 0004).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum OrderState {
  OPEN
  IN_PROGRESS
  COMPLETE
}

/// An order is one aggregate, so everything it owns is embedded and a transition is a single-document update.
model Order {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  state            OrderState        @default(OPEN)
  customer         Customer
  lineItems        LineItem[]
  assignedEmployee EmployeeSnapshot?
  /// Oldest first; one entry per transition.
  history          StateChange[]
  /// Optimistic-concurrency token: a transition only writes if the version it checked is still current.
  version          Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  /// Serves `orders(filter: { state })`, newest first.
  @@index([state, id(sort: Desc)])
  @@map("orders")
}

type Customer {
  name  String
  email String
}

type LineItem {
  sku            String
  name           String
  quantity       Int
  unitPriceCents Int
}

/// Copy of the employee at assignment time, so the order stays readable even if the employee record changes.
type EmployeeSnapshot {
  id   String @db.ObjectId
  name String
}

type StateChange {
  from       OrderState
  to         OrderState
  at         DateTime
  employeeId String?    @db.ObjectId
}

model Employee {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String

  @@map("employees")
}
