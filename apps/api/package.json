{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "yarn test:unit && yarn test:int",
    "test:unit": "run -T vitest run",
    "test:int": "run -T vitest run -c vitest.int.config.js",
    "db:push": "prisma db push --skip-generate"
  },
  "dependencies": {
    "@apollo/server": "^5",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14",
    "@nestjs/common": "^12",
    "@nestjs/config": "^12",
    "@nestjs/core": "^12",
    "@nestjs/graphql": "^14",
    "@nestjs/platform-express": "^12",
    "@prisma/client": "6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5",
    "graphql": "^16.11",
    "nestjs-pino": "^5.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12",
    "@nestjs/testing": "^12",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.2.0",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "unplugin-swc": "^1.6.0"
  }
}
