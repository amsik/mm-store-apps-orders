# Copy to apps/api/.env for local overrides. Every variable is validated at boot (src/core/config/app-config.ts).

# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Prisma on MongoDB needs a replica set; `docker compose up -d mongo` starts a single-node rs0.
DATABASE_URL=mongodb://localhost:27018/mm-order?replicaSet=rs0&directConnection=true
# Comma-separated browser origins allowed by CORS (the Vite dev server); empty = no cross-origin access.
CORS_ORIGINS=http://localhost:5173
# Schema introspection + the GraphiQL page at /graphql. Default: true, except in production.
# GRAPHQL_INTROSPECTION=true
# Maximum selection depth of a query (introspection exempt).
GRAPHQL_MAX_DEPTH=8
