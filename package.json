{
  "name": "mm-store-apps-orders",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "postinstall": "husky",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json && yarn workspaces foreach -Apt --include '@app/*' run typecheck",
    "test": "vitest run",
    "build": "yarn workspaces foreach -Apt --include '@app/*' run build",
    "check:pr": "node scripts/check-pr.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/lint": "^21.2.3",
    "@commitlint/load": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10",
    "@types/node": "^24",
    "eslint": "^10",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8",
    "vite": "^8.3.0",
    "vitest": "^5"
  }
}
